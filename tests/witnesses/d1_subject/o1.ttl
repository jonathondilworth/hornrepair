@prefix : <http://example.org/o1#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/o1> a owl:Ontology .

:BiographicalAuthor a owl:Class ;
    rdfs:label "BiographicalAuthor" ;
    rdfs:subClassOf :Author ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :writes ; owl:someValuesFrom :Biography ] .

:Author a owl:Class ;
    rdfs:label "Author" .

:Biography a owl:Class ;
    rdfs:label "Biography" ;
    rdfs:subClassOf :Book .

:Book a owl:Class ;
    rdfs:label "Book" .

:writes a owl:ObjectProperty ;
    rdfs:label "writes" .
