@prefix : <http://example.org/o2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/o2> a owl:Ontology .

:Paper a owl:Class ;
    rdfs:label "Paper" ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasCorrespondingAuthor ; owl:someValuesFrom :Faculty ] .

:Student a owl:Class ;
    rdfs:label "Student" ;
    owl:disjointWith :Faculty .

:Faculty a owl:Class ;
    rdfs:label "Faculty" .

:hasCorrespondingAuthor a owl:ObjectProperty ;
    rdfs:label "hasCorrespondingAuthor" .
