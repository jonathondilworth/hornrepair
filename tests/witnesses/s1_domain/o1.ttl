@prefix : <http://example.org/o1#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/o1> a owl:Ontology .

:MilitaryAsset a owl:Class ;
    rdfs:label "MilitaryAsset" ;
    rdfs:subClassOf :DefenceAsset ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :deployed ; owl:someValuesFrom :Location ] .

:DefenceAsset a owl:Class ;
    rdfs:label "DefenceAsset" .

:Location a owl:Class ;
    rdfs:label "Location" .

:deployed a owl:ObjectProperty ;
    rdfs:label "deployed" .
