@prefix : <http://example.org/o2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/o2> a owl:Ontology .

:Software a owl:Class ;
    rdfs:label "Software" ;
    owl:disjointWith :DefenceAsset .

:DefenceAsset a owl:Class ;
    rdfs:label "DefenceAsset" .

:deployed a owl:ObjectProperty ;
    rdfs:label "deployed" ;
    rdfs:domain :Software .
