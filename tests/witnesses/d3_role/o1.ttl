@prefix : <http://example.org/o1#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/o1> a owl:Ontology .

:StudentPaper a owl:Class ;
    rdfs:label "StudentPaper" ;
    rdfs:subClassOf :Paper ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :submittedBy ; owl:someValuesFrom :Student ] .

:Paper a owl:Class ;
    rdfs:label "Paper" .

:Student a owl:Class ;
    rdfs:label "Student" .

:submittedBy a owl:ObjectProperty ;
    rdfs:label "submittedBy" ;
    rdfs:subPropertyOf :hasSubmitter .

:hasSubmitter a owl:ObjectProperty ;
    rdfs:label "hasSubmitter" ;
    a owl:FunctionalProperty .
