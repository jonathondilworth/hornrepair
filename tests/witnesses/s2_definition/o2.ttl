@prefix : <http://example.org/o2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/o2> a owl:Ontology .

:PCReviewed a owl:Class ;
    rdfs:label "PCReviewed" ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :hasReviewer ; owl:allValuesFrom :PCMember ] .

:StudentTrackPaper a owl:Class ;
    rdfs:label "StudentTrackPaper" ;
    rdfs:subClassOf :Paper ;
    owl:disjointWith :PCReviewed .

:Paper a owl:Class ;
    rdfs:label "Paper" .

:PCMember a owl:Class ;
    rdfs:label "PCMember" .

:hasReviewer a owl:ObjectProperty ;
    rdfs:label "hasReviewer" .
