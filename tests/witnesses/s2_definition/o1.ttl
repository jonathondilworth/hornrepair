@prefix : <http://example.org/o1#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/o1> a owl:Ontology .

:Paper a owl:Class ;
    rdfs:label "Paper" ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasReviewer ; owl:allValuesFrom :SeniorPC ] .

:SeniorPC a owl:Class ;
    rdfs:label "SeniorPC" ;
    rdfs:subClassOf :PCMember .

:PCMember a owl:Class ;
    rdfs:label "PCMember" .

:hasReviewer a owl:ObjectProperty ;
    rdfs:label "hasReviewer" .
