@prefix : <http://example.org/o2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/o2> a owl:Ontology .

:LightlyReviewed a owl:Class ;
    rdfs:label "LightlyReviewed" ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :hasReviewer ; owl:maxCardinality "2"^^xsd:nonNegativeInteger ] .

:ConferencePaper a owl:Class ;
    rdfs:label "ConferencePaper" ;
    rdfs:subClassOf :Paper ;
    owl:disjointWith :LightlyReviewed .

:Paper a owl:Class ;
    rdfs:label "Paper" .

:hasReviewer a owl:ObjectProperty ;
    rdfs:label "hasReviewer" .
