@prefix : <http://example.org/o2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/o2> a owl:Ontology .

:Paper a owl:Class ;
    rdfs:label "Paper" ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasLeadReviewer ; owl:minCardinality "2"^^xsd:nonNegativeInteger ] .

:hasLeadReviewer a owl:ObjectProperty ;
    rdfs:label "hasLeadReviewer" ;
    rdfs:subPropertyOf :hasReviewer .

:hasReviewer a owl:ObjectProperty ;
    rdfs:label "hasReviewer" .
