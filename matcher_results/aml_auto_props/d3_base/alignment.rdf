<?xml version='1.0' encoding='utf-8'?>
<rdf:RDF xmlns='http://knowledgeweb.semanticweb.org/heterogeneity/alignment'
	 xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#' 
	 xmlns:xsd='http://www.w3.org/2001/XMLSchema#' 
	 alignmentSource='AgreementMakerLight'>

<Alignment>
	<xml>yes</xml>
	<level>0</level>
	<type>11</type>
	<onto1>http://example.org/o1</onto1>
	<onto2>http://example.org/o2</onto2>
	<uri1>http://example.org/o1</uri1>
	<uri2>http://example.org/o2</uri2>
	<map>
		<Cell>
			<entity1 rdf:resource="http://example.org/o1#hasCorrespondingAuthor"/>
			<entity2 rdf:resource="http://example.org/o2#hasCorrespondingAuthor"/>
			<measure rdf:datatype="http://www.w3.org/2001/XMLSchema#float">1.0</measure>
			<relation>=</relation>
		</Cell>
	</map>

	<map>
		<Cell>
			<entity1 rdf:resource="http://example.org/o1#Paper"/>
			<entity2 rdf:resource="http://example.org/o2#Paper"/>
			<measure rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.99</measure>
			<relation>=</relation>
		</Cell>
	</map>

	<map>
		<Cell>
			<entity1 rdf:resource="http://example.org/o1#Student"/>
			<entity2 rdf:resource="http://example.org/o2#Student"/>
			<measure rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.99</measure>
			<relation>=</relation>
		</Cell>
	</map>

</Alignment>
</rdf:RDF>
