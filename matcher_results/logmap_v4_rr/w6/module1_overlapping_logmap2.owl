<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/o1#"
     xml:base="http://example.org/o1"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/o1"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/o1#publishedBy -->

    <owl:ObjectProperty rdf:about="http://example.org/o1#publishedBy"/>
    


    <!-- http://example.org/o1#writes -->

    <owl:ObjectProperty rdf:about="http://example.org/o1#writes"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/o1#Author -->

    <owl:Class rdf:about="http://example.org/o1#Author">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/o1#writes"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://example.org/o1#Book"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://example.org/o1#publishedBy"/>
                                <owl:someValuesFrom rdf:resource="http://example.org/o1#Publisher"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://example.org/o1#Book -->

    <owl:Class rdf:about="http://example.org/o1#Book">
        <rdfs:subClassOf rdf:resource="http://example.org/o1#Document"/>
    </owl:Class>
    


    <!-- http://example.org/o1#Document -->

    <owl:Class rdf:about="http://example.org/o1#Document"/>
    


    <!-- http://example.org/o1#Publisher -->

    <owl:Class rdf:about="http://example.org/o1#Publisher"/>
</rdf:RDF>



